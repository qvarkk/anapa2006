DEBUG=true

TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN_HERE>

# Add bot with given token as channel admin (media cache channel)
TELEGRAM_CACHE_CHANNEL_CHAT_ID=<YOUR_CACHE_CHANNEL_CHAT_ID>

# Optional: seeded as the first target channel when the target_channels table is
# empty. Target channels are otherwise managed from the bot UI.
TELEGRAM_CHANNEL_CHAT_ID=<YOUR_CHANNEL_CHAT_ID>

# Your numeric Telegram user ID (@userinfobot tells you). The owner gets full
# access and is the only one who can manage users. Send /bootstrap to the bot
# once to add yourself to the database.
TELEGRAM_OWNER_ID=<YOUR_TELEGRAM_USER_ID>

# Use this for local development
# DB_PATH=./data/anapa2006.db

# By default pointing to the rsshub service in compose.yaml
# RSSHUB_BASE_URL=http://rsshub:1200

# FETCH_INTERVAL=15m
# POST_INTERVAL=1m